# ambiente di sviluppo
.venv/
__pycache__/
*.py[cod]

# artefatti di compilazione
build/
dist/
Distribuzione/
*.spec

# copie di sicurezza prodotte dal programma: la cartella Backup/ tiene la
# propria .gitignore, questa copre le versioni vecchie e i file sparsi
Inventario_prima_del_reset_*.xlsx
Backup/*
!Backup/.gitignore

# l'inventario di produzione: uno solo, sulla share, mai nel repository
Produzione/*
!Produzione/.gitignore

# file generati a runtime (solo nella radice: i dati di esempio restano)
/avvio.log
/inventario_percorso.json
/inventario_impostazioni.json
/Inventario.xlsx
/Inventario dispositivi.lnk
.*.xlsx.lock
*.tmp-*

# macOS
.DS_Store
